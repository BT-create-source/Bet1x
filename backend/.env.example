# =============================================================================
# bet1x backend configuration
#
# Copy to backend/.env and fill in real values. Every entry marked REQUIRED must
# be set when NODE_ENV=production — the process refuses to start otherwise,
# which is deliberate: a live money platform must never boot on a default secret.
# =============================================================================

# ---------------------------------------------------------------- environment
# development | production
NODE_ENV=development

# ---------------------------------------------------------------- secrets
# REQUIRED in production. Signs every session token; anyone who knows it can mint
# a valid admin session. Minimum 32 characters of real entropy.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# ---------------------------------------------------------------- admin console
ADMIN_USERNAME=admin

# REQUIRED in production. A bcrypt hash — never the password itself.
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'your-password'
ADMIN_PASSWORD_HASH=

# Development-only convenience: a plaintext admin password. Rejected outright
# when NODE_ENV=production. Leave both admin values blank in development and the
# console accepts admin / admin123.
# ADMIN_PASSWORD=

# ---------------------------------------------------------------- database
# REQUIRED in production.
DATABASE_URL="postgresql://user:password@localhost:5432/bet1x?schema=public"

# Fall back to flat JSON files in backend/data when Postgres is unreachable.
# Handy on a laptop, unsafe in production: it silently creates a second, diverging
# source of truth for player balances. Defaults to true in development, false in
# production.
# ALLOW_JSON_FALLBACK=false

# ---------------------------------------------------------------- http
PORT=5000
HOST=0.0.0.0

# Number of reverse proxies in front of this process (nginx, Cloudflare, a PaaS
# router). Must be non-zero in production or rate limiting and audit logs will
# see the proxy's IP for every visitor instead of the real client's.
TRUST_PROXY=0

# Extra browser origins allowed to call the API, comma separated. Leave empty for
# the normal setup where this same process also serves the site.
# CORS_ORIGINS=https://www.example.com,https://example.com

# Redirect http:// to https:// using the proxy's X-Forwarded-Proto header, and
# send HSTS. Defaults to true in production. Requires TRUST_PROXY to be set.
# FORCE_HTTPS=true

# ---------------------------------------------------------------- product rules
# Credits given to a brand new account. Set to 0 for a real-money deployment;
# the non-zero development default is what makes the demo playable after signup.
SIGNUP_BONUS=0

# Allow an unknown username in a request to silently create a funded account.
# Keep this false — with a bonus configured it is an unlimited free-money faucet.
ALLOW_AUTO_USER_CREATION=false

BCRYPT_ROUNDS=12
SESSION_TTL_HOURS=168

# Table limits, enforced server-side on every stake.
MIN_BET=1
MAX_BET=100000
MIN_WITHDRAWAL=100

# error | warn | info | debug
LOG_LEVEL=info

# --- House-edge engine ---
# When a round is rigged, choose Aviator's crash point from the stake actually exposed instead of a
# fixed random band. Set false to fall back to the original behaviour.
AVIATOR_SMART_CRASH=true
# Targeted pending stake at which the crash point is pulled to the aggressive end of its band.
AVIATOR_HIGH_STAKE_REF=1000

# --- Cricket: Your 11 and Boundary Baazi ---
# Master switch for both cricket games. With this false no cricket route is registered and no sync
# job runs, so the rest of the site is exactly as it was before the integration. This is also the
# staged-rollout flag: leave it false until you are ready to expose the games.
CRICKET_ENABLED=false

# Roanuz Cricket API (cricketapi.com), Standard licence.
#
# SPEND GUARDRAIL: the only paid product that should be active on this account is Match Via Push
# (~Rs 200/match). Fixtures, squads, tables and stats come from the FREE tournament-level endpoints.
# Do not enable Fantasy Match Points, Fantasy Match Credits, or the paid Fixtures API — scoring and
# player credits are computed in-house from the ball event log. The one exception is Tournament
# Player Stats (Rs 10/player), used ONCE per tournament to cold-start the credit algorithm.
#
# Both are REQUIRED in production when CRICKET_ENABLED=true. Dropping real values in here is what
# flips backend/lib/cricket/roanuz.js from the mock transport to the live one automatically (see
# ROANUZ_TRANSPORT below) — going live needs no other code or config change.
ROANUZ_API_TOKEN=
ROANUZ_PROJECT_KEY=

# Verifies a push delivery actually came from Roanuz. TWO mechanisms are checked (either is
# sufficient) because Roanuz's own docs describe no signature header at all — see the 2026-08-24
# amendment in docs/CRICKET-BUILD-BRIEF.md:
#   1. An HMAC-SHA256 signature header (kept in case Roanuz turns out to support one after all).
#   2. This same secret appended to the registered webhook URL as ?secret=... or sent as the
#      x-roanuz-secret header — the confirmed-workable option, since Roanuz's console does let you
#      register an arbitrary URL to deliver to.
# REQUIRED in production when cricket is on: without it the webhook is an unauthenticated endpoint
# writing straight into the permanent ball event log, and anyone who finds the URL can forge
# deliveries that decide real payouts.
ROANUZ_WEBHOOK_SECRET=

# Which transport backend/lib/cricket/roanuz.js talks through. Leave UNSET — it resolves itself:
# 'live' the moment ROANUZ_API_TOKEN/ROANUZ_PROJECT_KEY above are both set, 'mock' otherwise (canned,
# documentation-shaped responses — see backend/lib/cricket/roanuz-transport.js — with no network
# call ever made). Force 'mock' to develop/demo against the mock even with real credentials present;
# a production boot with CRICKET_ENABLED=true refuses to start if this resolves to 'mock'.
# ROANUZ_TRANSPORT=mock

# Override only for a sandbox host, a proxy, or if Roanuz revises these paths — both are confirmed
# against their public docs as of 2026-08-24 (auth lives under /core/, everything else /cricket/).
# ROANUZ_AUTH_BASE_URL=https://api.sports.roanuz.com/v5/core
# ROANUZ_BASE_URL=https://api.sports.roanuz.com/v5/cricket

# Tournaments currently covered, comma separated, by Roanuz tournament key.
# ROANUZ_TOURNAMENT_IDS=ipl_2026,wc_2026

# Seconds a covered live match may go without a ball event before the feed is treated as stalled.
# Currently logged only — there is no alert channel wired up yet, so a stall is visible only to
# someone reading the process logs. Wire one before a real match relies on this.
CRICKET_STALL_SECONDS=90

# How often the free fixtures/squad endpoints are polled, in hours. Keep this low-frequency: the
# Standard licence allows roughly 1,200 unique resources per month, and live data arrives via the
# push feed rather than polling.
CRICKET_FIXTURE_SYNC_HOURS=6

# The account the Your 11 house entry plays from (docs/YOUR11-SCOPE.md section 4). Must be a real
# user account: the house entry pays its own entry fee into the prize pool from this wallet, because
# a house entrant that paid nothing would mean real players funding its prize, and would make the
# guaranteed-pool liability figures in the admin console wrong.
#
# Leave BLANK to disable the house entry entirely. Blank is the safe default — the feature switches
# itself off rather than entering contests for free.
CRICKET_HOUSE_ACCOUNT=

# --- Testing only ---
# Turns off the per-IP auth / cashier / chat / wallet limiters so a load test can drive dozens of
# accounts from one machine (npm run test:load). The auth limiter is login brute-force protection,
# so this is DEVELOPMENT ONLY: the process refuses to start if NODE_ENV=production and this is set.
# Leave it false for normal use.
DISABLE_RATE_LIMITS=false
