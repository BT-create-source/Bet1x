datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String
  password       String
  wallet_balance Float    @default(1000.0)
  created_at     DateTime @default(now())
}

model Transaction {
  id        String   @id
  user      String
  type      String
  amount    Float
  details   String
  status    String
  timestamp DateTime @default(now())
}

model Deposit {
  deposit_id     String   @id
  order_id       String?  @unique
  username       String
  amount         Float
  utr            String?
  qr_type        String?
  custom_qr_data String?
  status         String
  gateway        String?
  gateway_id     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())
}

model Withdrawal {
  withdrawal_id String   @id
  username      String
  amount        Float
  method        String
  details       String
  status        String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
}

model PaymentLog {
  id        String   @id
  payload   Json
  signature String?
  timestamp DateTime @default(now())
}

model GameState {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model RecentResult {
  id          Int      @id @default(autoincrement())
  room        String
  roundNumber String
  number      Int
  color       String
  dotClass    String
  size        String
  timestamp   DateTime @default(now())

  @@unique([room, roundNumber])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  username  String
  message   String
  timestamp DateTime @default(now())
}

model TeenPattiRoom {
  id            String   @id                    // "room_101", "room_102", etc.
  name          String                          // "VIP Diamond Club"
  boot_amount   Float    @default(10)
  status        String   @default("waiting")    // waiting | playing | finished
  pot           Float    @default(0)
  current_stake Float    @default(10)
  turn_index    Int      @default(0)
  turn_seat     Int?
  turn_start    DateTime?
  round         Int      @default(1)
  winner_seat   Int?
  deck_state    Json?
  admin_rig     Json?
  log           Json     @default("[]")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  seats         TeenPattiSeat[]
}

model TeenPattiSeat {
  id        Int      @id @default(autoincrement())
  room_id   String
  seat      Int                                // 0, 1, 2, 3
  username  String?                            // null = empty, "BOT_Raju" = bot
  is_bot    Boolean  @default(false)
  cards     Json?                              // [{r:14,s:'S'}, ...]
  folded    Boolean  @default(false)
  balance   Float    @default(0)
  seen      Boolean  @default(false)
  room      TeenPattiRoom @relation(fields: [room_id], references: [id])

  @@unique([room_id, seat])
}

model GameBet {
  id         String    @id @default(uuid())
  username   String
  game       String                              // 'mines', 'cricket', 'football', 'boundarybaazi'
  bet_amount Float
  payout     Float     @default(0)
  status     String    @default("active")        // active, won, lost, cashed
  metadata   Json?                               // game-specific data
  created_at DateTime  @default(now())
  settled_at DateTime?

  @@index([username, game])
  @@index([game, status])
}
