# ---------------------------------------------------------------------------
# Secrets — never commit these.
# Covers backend/.env, php-backend/.env, php-backend/.env.production (written by
# tools/make-production-env.php) and any other .env.*; only .env.example files
# are tracked. backend/.env and football-live-app/.env were committed in early
# history and later untracked, so the values in those old commits are public to
# anyone with the repo: never reuse them in production.
# Production secrets (APP_SECRET, DB password, operator password hashes,
# ROANUZ_API_KEY / ROANUZ_PROJECT_KEY / ROANUZ_WEBHOOK_SECRET, SMTP/SMS keys)
# live ONLY in the server's php-backend/.env.
# ---------------------------------------------------------------------------
.env
# See DEPLOYMENT.md ("Secrets that are already in git history").
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
*.secret

# Dependencies
node_modules/
.pnp
.pnp.js

# Runtime data
backend/data/*.json
!backend/data/.gitkeep
*.log
logs/
php-backend/tests/reports/
pids/
*.pid
*.seed

# Build / tooling output
dist/
build/
coverage/
.nyc_output/
.cache/

# Editor & OS noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Backups and scratch files
*.bak
*.backup
*.orig
*.orig-backup
*.tmp
