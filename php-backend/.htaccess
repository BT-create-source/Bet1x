# =================================================================================================
# php-backend/ is application code, not a document root.
#
# Nothing in here may be fetched directly over HTTP. The ONE exception is index.php, which the root
# .htaccess rewrites /api/* into — an internal redirect, which Apache re-authorises, so index.php
# has to be explicitly granted or the whole API 403s.
#
# This directory-level rule also covers lib/, routes/, games/, sql/ and cron/, because an .htaccess
# applies to subdirectories too. That is what keeps .env, the schema and the cron script private.
# =================================================================================================

<IfModule mod_authz_core.c>
    Require all denied
    <Files "index.php">
        Require all granted
    </Files>
</IfModule>

# Apache 2.2 fallback, for hosts that have not migrated.
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "index.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

Options -Indexes
