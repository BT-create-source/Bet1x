# =================================================================================================
# bet1x — PHP backend configuration
#
# Copy to php-backend/.env and fill in. Values already present in the real environment (cPanel's
# "Environment Variables" panel, or SetEnv in .htaccess) take precedence over this file.
#
# php-backend/.htaccess denies HTTP access to this whole directory, so .env is not web-readable —
# but keep it out of git as well. The repository .gitignore already covers .env.
# =================================================================================================

NODE_ENV=production

# --- Secrets -------------------------------------------------------------------------------------
# THE MOST IMPORTANT LINE IN THIS FILE.
#
# Set this to the SAME value the Node build used and every session token already sitting in a
# player's browser stays valid across the cutover — nobody is signed out. Change it and everyone,
# players and operators alike, is signed out once and has to log in again. Nothing else breaks.
#
# Generate a fresh one with:  php -r "echo bin2hex(random_bytes(48));"
APP_SECRET=

# --- Admin credentials ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
# bcrypt hash, never a plaintext password. Generate with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT, ['cost'=>12]);"
ADMIN_PASSWORD_HASH=

# --- Database ------------------------------------------------------------------------------------
# Either a single URL (same postgresql:// scheme the Node build used):
#   DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/dbname
# ...or the discrete values cPanel's PostgreSQL database wizard gives you:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=

# Flat-file fallback if Postgres is unreachable. Off in production by default: writing balances to
# a JSON file while the real database is down produces two divergent sources of truth for money.
ALLOW_JSON_FALLBACK=false

# --- Timezone ------------------------------------------------------------------------------------
# NOT cosmetic. Colour-prediction history and /api/db/recent-results serialise timestamps as a bare
# local HH:MM:SS with no date and no offset, while round ids are computed in UTC. Set this to the
# same zone the Node process ran in, or those history strings shift by hours.
APP_TIMEZONE=UTC

# --- HTTP ----------------------------------------------------------------------------------------
# Number of reverse proxies in front of the app. cPanel behind Cloudflare is usually 1; a plain
# cPanel host with no proxy is 0. Required for correct client IPs in rate limiting and logs.
TRUST_PROXY=0

# Browser origins allowed to call the API. Leave EMPTY for the normal same-origin deployment where
# this backend and the HTML pages share a domain. Only fill this in if the pages are hosted
# elsewhere — and note that would also require editing the frontend, which this port avoids.
CORS_ORIGINS=

FORCE_HTTPS=true

# --- Product rules -------------------------------------------------------------------------------
# Credits given to a brand new account. A real-money deployment almost always wants 0.
SIGNUP_BONUS=0

# Historically any unknown username in a request body was silently created with a funded wallet —
# an unlimited free-money faucet. Leave false.
ALLOW_AUTO_USER_CREATION=false

# Must stay 12 to match the existing password hashes.
BCRYPT_ROUNDS=12

SESSION_TTL_HOURS=168
MIN_BET=1
MAX_BET=100000
MIN_WITHDRAWAL=100

LOG_LEVEL=info

# --- Testing switch ------------------------------------------------------------------------------
# Turns off the per-IP limiters so a load test can drive many accounts from one machine. This is
# the brute-force protection on the login endpoint, so the app REFUSES TO START with it set while
# NODE_ENV=production. Never enable it on a live site.
DISABLE_RATE_LIMITS=false

# --- House-edge engine ---------------------------------------------------------------------------
# When a round is selected for rigging, Aviator's crash point can be computed from the stake
# actually exposed rather than drawn from a fixed random band. Set false to revert to the original
# band; this has no effect at all on rounds the takeover engine did not already select.
AVIATOR_SMART_CRASH=true
# Targeted pending stake at which the crash point is pulled to the aggressive end of its band.
AVIATOR_HIGH_STAKE_REF=1000
# Teen Patti pads any table short of 4 seats with randomly-named NPC fillers, and runs a background
# "organic traffic" engine that seats simulated players into empty rooms. Off automatically when
# NODE_ENV=production (a real launch should only ever show players who actually sat down); on by
# default otherwise so a lone developer still sees a full table. Set explicitly to override either
# way. Does not affect the "Admin" house seat used for rigging, which keeps working either way.
# TEENPATTI_AUTO_BOT_FILL=false

# --- Withdrawal and abuse controls ---------------------------------------------------------------
# php-backend/lib/riskcontrols.php. All default OFF so an existing deployment is unchanged; the
# production .env produced by tools/make-production-env.php turns the withdrawal ones on.
# Requires migration-002-risk-controls.sql to have been applied.
#
# The one that closes signup-bonus farming. Registration is unverified (no email, phone or KYC), so
# without this a scripted signup loop turns SIGNUP_BONUS into withdrawable cash, once per throwaway
# account. With it on, an account that never had a deposit approved has nothing to cash out.
# Booting with SIGNUP_BONUS > 0 while this is false is a fatal configuration error in production.
WITHDRAWAL_REQUIRE_DEPOSIT=false
# Rolling 24h ceilings. 0 disables the individual check. Counts Pending as well as Completed, so a
# queue stuffed with unapproved requests is caught rather than waved through.
WITHDRAWAL_DAILY_MAX=0
WITHDRAWAL_DAILY_COUNT_MAX=0
# Per-IP registration cap. Leave at 0 unless responding to observed farming: Indian mobile networks
# use carrier-grade NAT, so thousands of unrelated users share one public IP and a tight cap blocks
# genuine customers while farmers just rotate addresses.
SIGNUP_MAX_PER_IP_PER_DAY=0

# --- Monitoring ----------------------------------------------------------------------------------
# /api/ready returns 503 once the one-minute cron heartbeat is older than this many seconds, which
# is what makes a silently dead cron alertable. 0 disables the check.
CRON_STALE_SECONDS=300

# --- Backups (php-backend/cron/backup.php) -------------------------------------------------------
# BACKUP_DIR must be OUTSIDE the document root — dumps contain every password hash on the platform.
# BACKUP_DIR=/home/CPANELUSER/backups
# BACKUP_KEEP_DAYS=14
# PG_DUMP_PATH=/usr/bin/pg_dump

# --- Cricket (Your 11 / Boundary Baazi) ----------------------------------------------------------
# Deferred to v2 and NOT part of this build: no cricket route exists, so setting this true today
# changes nothing. When the two games are ported, this is the switch that turns them on — alongside
# deleting the [data-feature="cricket"] rule at the bottom of assets/css/style.css.
CRICKET_ENABLED=false
